{
  "title": "Triton serving: batching and latency",
  "uid": "triton-batching",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Achieved batch size (requests per forward pass)",
      "description": "nv_inference_request_success counts requests; nv_inference_exec_count counts forward passes. Their ratio is the batch size Triton actually formed, which is the one metric that distinguishes 'batching did not help' from 'batching did not happen'. A value pinned at 1.0 under load means the queue delay is being paid for nothing.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 2 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(nv_inference_request_success[30s]) / clamp_min(rate(nv_inference_exec_count[30s]), 0.0001)",
          "legendFormat": "{{model}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Throughput (inferences per second)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": { "lineWidth": 2, "fillOpacity": 10 }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(nv_inference_count[30s])",
          "legendFormat": "{{model}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Where a request spends its time",
      "description": "Triton reports queue and compute durations separately. Queue time rising while compute time stays flat is the signature of a server that is saturated rather than slow, which is the condition under which batching has something to work with.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "µs",
          "min": 0,
          "custom": { "lineWidth": 2, "fillOpacity": 10, "stacking": { "mode": "normal" } }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(nv_inference_queue_duration_us[30s]) / clamp_min(rate(nv_inference_request_success[30s]), 0.0001)",
          "legendFormat": "queue"
        },
        {
          "refId": "B",
          "expr": "rate(nv_inference_compute_infer_duration_us[30s]) / clamp_min(rate(nv_inference_request_success[30s]), 0.0001)",
          "legendFormat": "compute"
        },
        {
          "refId": "C",
          "expr": "rate(nv_inference_compute_input_duration_us[30s]) / clamp_min(rate(nv_inference_request_success[30s]), 0.0001)",
          "legendFormat": "input handling"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Failed requests",
      "description": "Non-zero here invalidates the latency panels, since a fast failure looks like a fast response to a load generator that only measures what returned.",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(nv_inference_request_failure[15m]))",
          "legendFormat": "failures"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Model execution count",
      "description": "Total forward passes. Compare against request count to sanity-check the batch-size panel.",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 8 },
      "fieldConfig": {
        "defaults": { "unit": "none" },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(nv_inference_exec_count)",
          "legendFormat": "forward passes"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Queue time as a share of total request time",
      "description": "The fraction of a request's life spent waiting rather than computing. Dynamic batching trades a small deliberate increase in this for a larger decrease in it under load.",
      "gridPos": { "h": 5, "w": 12, "x": 12, "y": 12 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": { "lineWidth": 2, "fillOpacity": 10 }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(nv_inference_queue_duration_us[30s]) / clamp_min(rate(nv_inference_request_duration_us[30s]), 0.0001)",
          "legendFormat": "{{model}}"
        }
      ]
    }
  ]
}
